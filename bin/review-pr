#!/bin/sh
# Trigger one review run.
#
#   bin/review-pr                    local simulator (no cluster needed)
#   bin/review-pr --backend cluster  against the current kube context
#
# Any extra flags are passed to the CLI.
set -eu
cd "$(dirname "$0")/.."
export PYTHONPATH="${PYTHONPATH:-}:$PWD/agent"
exec python3 -m reviewagent.cli \
  --repo "${WORKSHOP_REPO:-.build/workshop-repo}" \
  --backend "${KUBE_BACKEND:-local}" \
  --audit-log "${AUDIT_LOG:-audit/events.jsonl}" \
  review-pr --quiet "$@"
