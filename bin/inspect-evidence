#!/bin/sh
# Print the evidence the last local run produced: agent audit log, workload
# history, Kubernetes Events and simulated container logs.
set -eu
cd "$(dirname "$0")/.."
export PYTHONPATH="${PYTHONPATH:-}:$PWD/agent"
exec python3 -m reviewagent.cli \
  --repo "${WORKSHOP_REPO:-.build/workshop-repo}" \
  --backend "${KUBE_BACKEND:-local}" \
  --audit-log "${AUDIT_LOG:-audit/events.jsonl}" \
  inspect "$@"
